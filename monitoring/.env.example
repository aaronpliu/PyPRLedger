# ──────────────────────────────────────────────
# PRLedger Monitoring Stack — Environment Config
# ──────────────────────────────────────────────
# Copy this to .env and fill in your values.
#   cp .env.example .env
#
# Then deploy:
#   docker compose -f docker-compose.yml up -d
#
# NOTE: The Docker network 'code-review-network' must exist.
# Create it with: docker network create code-review-network
# ──────────────────────────────────────────────

# ─── Grafana ──────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
# grafana-piechart-panel was deprecated and removed from the plugin registry
# in Grafana 11+. Pie charts are now built into Grafana natively.
# Leave this empty unless you need a specific external plugin.
GF_INSTALL_PLUGINS=

# ─── AlertManager (Slack) ────────────────────
# Leave blank to disable Slack notifications (console-only mode).
# Set to your Slack Incoming Webhook URL to enable.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#monitoring-alerts

# ─── Prometheus ───────────────────────────────
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
