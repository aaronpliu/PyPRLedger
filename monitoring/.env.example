# ──────────────────────────────────────────────
# PRLedger Monitoring Stack — Environment Config
# ──────────────────────────────────────────────
# Copy this to .env and fill in your values.
#   cp .env.example .env
#
# Then deploy:
#   docker compose -f docker-compose.yml up -d
#
# NOTE: The Docker network 'app-network' must exist.
# Create it with: docker network create app-network
# ──────────────────────────────────────────────

# ─── Grafana ──────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_INSTALL_PLUGINS=grafana-piechart-panel

# ─── AlertManager (Slack) ────────────────────
# Leave blank to disable Slack notifications (console-only mode).
# Set to your Slack Incoming Webhook URL to enable.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#monitoring-alerts

# ─── Prometheus ───────────────────────────────
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
