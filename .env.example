# FastAPI Pull Request Code Review System - Environment Variables
# Copy this file to .env and update the values according to your environment

# ==============================
# Project Information
# ==============================
PROJECT_NAME=PR Code Review Result Storage System
API_V1_STR=/api/v1

# ==============================
# Environment Configuration
# ==============================
ENV=development
DEBUG=False
LOG_LEVEL=INFO
# ==============================
# API Documentation Configuration
# ==============================
# API docs are always hidden in production for security
# In development, set to False to hide docs, True to show them
ENABLE_API_DOCS=True

# ==============================
# Timezone Configuration
# ==============================
TIMEZONE=Asia/Shanghai
USE_UTC_IN_DB=False  # If True, use UTC timezone in database

# ==============================
# Database Configuration
# ==============================
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_username_here
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=code_review
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=60

# ==============================
# Redis Configuration
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_password_here
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100
REDIS_PUBSUB_MAX_CONNECTIONS=20

# ==============================
# Cache TTL Settings (seconds)
# ==============================
CACHE_TTL_REVIEWS=3600
CACHE_TTL_PROJECTS=21600
CACHE_TTL_USERS=43200
CACHE_TTL_STATS=3600
CACHE_TTL_RELEASE_DIFF=300

# ==============================
# Security Configuration
# ==============================
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_IDLE_TIMEOUT_MINUTES=60
ACCESS_TOKEN_REFRESH_THRESHOLD_SECONDS=60
ID_OBFUSCATOR_SALT=change-this-to-a-random-secret-string

# ==============================
# CORS Configuration
# ==============================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:63342,http://127.0.0.1:63342,http://127.0.0.1:4173

# ==============================
# Rate Limit Configuration
# ==============================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_PERIOD_SECONDS=60

# ==============================
# Concurrency Control Configuration
# ==============================
MAX_CONCURRENT_OPERATIONS=1000
DB_QUERY_TIMEOUT=30

# ==============================
# Prometheus Monitoring Configuration
# ==============================
PROMETHEUS_ENABLED=True
PROMETHEUS_METRICS_PATH=/api/metrics

# ==============================
# Pagination Defaults
# ==============================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ==============================
# Git Configuration
# ==============================
GIT_MAX_DIFF_SIZE=1048576
GIT_MAX_FILES_IN_PR=100

# ==============================
# Code Review Configuration
# ==============================
REVIEW_MIN_SCORE=0
REVIEW_MAX_SCORE=10

# ==============================
# Task Processing Configuration
# ==============================
TASK_QUEUE_ENABLED=True
MAX_RETRIES=3

# ==============================
# Bitbucket API Configuration
# ==============================
# Both Bitbucket Server/Data Center and Bitbucket Cloud can be configured at the same
# time. Which one is used is decided per project (project_registry.git_provider) or per
# request payload/UI selection, not globally:
#   1. project_registry entry for (project_key, repository_slug)  <- authoritative
#   2. git_provider field of the incoming payload (PR review / release diff request)
#   3. fallback: bitbucket_server
# BITBUCKET_CLOUD is kept only for backwards compatibility and does not route traffic.

# Bitbucket Server/Data Center base URL (used when git_provider=bitbucket_server)
BITBUCKET_SERVER_URL=http://localhost:7990

# Bitbucket Server credentials (username and password/app-password)
BITBUCKET_USER=admin
BITBUCKET_PASSWORD=your_password_here

# Bitbucket Server/Data Center Personal Access Token (PAT).
# When set, it takes precedence over BITBUCKET_USER/BITBUCKET_PASSWORD and is sent as a Bearer token.
# Leave empty to use Basic auth (username + password/app password) instead.
# NOTE: PATs are only available on Bitbucket Server/Data Center, not Bitbucket Cloud.
# BITBUCKET_TOKEN=your_personal_access_token_here

# Bitbucket Cloud (bitbucket.org) configuration - used when the git provider is bitbucket_cloud
# REST API 2.0 base URL (the API host is api.bitbucket.org, NOT bitbucket.org)
BITBUCKET_CLOUD_API_URL=https://api.bitbucket.org/2.0
# OAuth2 / workspace access token. When set it takes precedence and is sent as a Bearer token
# BITBUCKET_CLOUD_TOKEN=your_cloud_access_token_here
# Cloud credentials (Atlassian account + app password). Leave empty to reuse
# BITBUCKET_USER / BITBUCKET_PASSWORD - set them when running Server and Cloud side by side
# BITBUCKET_CLOUD_USER=your_atlassian_username
# BITBUCKET_CLOUD_APP_PASSWORD=your_app_password
# Workspaces offered in the UI (comma separated). Suggestions are merged with the
# workspaces discoverable through the API and the ones already synced locally;
# any other workspace can still be typed manually.
# BITBUCKET_CLOUD_WORKSPACES=aaronpliu,another-workspace

# Default workspace/project key for repository lookups
BITBUCKET_DEFAULT_WORKSPACE=PROJ

# GitHub Enterprise API Configuration (optional - for multi-provider support)
# GITHUB_ENTERPRISE_URL=https://github.example.com
# GITHUB_ENTERPRISE_TOKEN=ghp_xxxx

# ==============================
# Notification Configuration
# ==============================
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_DIGEST_ENABLED=True
NOTIFICATION_DIGEST_FREQUENCY=daily
NOTIFICATION_MAX_PER_DAY=100

# ==============================
# Email Configuration (SMTP)
# ==============================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=PyPRLedger Notifications
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# ==============================
# Slack Integration Configuration
# ==============================
SLACK_WEBHOOK_URL=
SLACK_ENABLED=False

# ==============================
# LLM Proxy Configuration (PageAgent)
# ==============================
# These are fallback defaults; runtime settings from the system_settings table take precedence.
LLM_PROXY_ENABLED=False
LLM_DEFAULT_MODEL=
LLM_DEFAULT_BASE_URL=
LLM_DEFAULT_API_KEY=